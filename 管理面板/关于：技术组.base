filters:
  and:
    - file.inFolder("cms/aboutTechGroups")
    - file.ext == "md"
properties:
  label:
    displayName: 名称
  icon:
    displayName: 图标
  items:
    displayName: 技术条目
  title:
    displayName: 标题
  draft:
    displayName: 草稿
  visible:
    displayName: 显示
  order:
    displayName: 排序（小值优先）
  publishAt:
    displayName: 定时发布
  unpublishAt:
    displayName: 定时下线
views:
  - type: table
    name: 表格
    order:
      - file.name
      - label
      - icon
      - items
      - title
      - draft
      - visible
      - order
      - publishAt
      - unpublishAt
    sort:
      - property: order
        direction: ASC
  - type: cards
    name: 卡片
    order:
      - file.name
      - title
      - name
      - draft
      - visible
      - publishAt
    image: note.cover
    cardSize: 220
