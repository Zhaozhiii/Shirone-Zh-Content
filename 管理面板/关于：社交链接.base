filters:
  and:
    - file.inFolder("cms/aboutSocialLinks")
    - file.ext == "md"
properties:
  brand:
    displayName: 品牌
  href:
    displayName: 链接
  platform:
    displayName: 平台
  handle:
    displayName: 账号
  icon:
    displayName: 图标
  note:
    displayName: 说明
  title:
    displayName: 标题
  draft:
    displayName: 草稿
  visible:
    displayName: 显示
  order:
    displayName: 排序（小值优先）
  publishAt:
    displayName: 定时发布
  unpublishAt:
    displayName: 定时下线
views:
  - type: table
    name: 表格
    order:
      - file.name
      - brand
      - href
      - platform
      - handle
      - icon
      - note
      - title
      - draft
      - visible
      - order
      - publishAt
      - unpublishAt
    sort:
      - property: order
        direction: ASC
  - type: cards
    name: 卡片
    order:
      - file.name
      - title
      - name
      - draft
      - visible
      - publishAt
    image: note.cover
    cardSize: 220
