filters:
  and:
    - file.inFolder("content/moments")
    - file.ext == "md"
properties:
  published:
    displayName: 日期
  location:
    displayName: 位置
  mood:
    displayName: 心情图标
  tags:
    displayName: 标签
  images:
    displayName: 图片
  pinned:
    displayName: 置顶
  title:
    displayName: 标题
  draft:
    displayName: 草稿
  visible:
    displayName: 显示
  order:
    displayName: 排序（小值优先）
  publishAt:
    displayName: 定时发布
  unpublishAt:
    displayName: 定时下线
views:
  - type: table
    name: 表格
    order:
      - file.name
      - published
      - location
      - mood
      - tags
      - images
      - pinned
      - title
      - draft
      - visible
      - order
      - publishAt
      - unpublishAt
    sort:
      - property: order
        direction: ASC
  - type: cards
    name: 卡片
    order:
      - file.name
      - title
      - name
      - draft
      - visible
      - publishAt
    image: note.cover
    cardSize: 220
