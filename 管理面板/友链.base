filters:
  and:
    - file.inFolder("cms/friends")
    - file.ext == "md"
properties:
  id:
    displayName: 编号
  title:
    displayName: 标题
  imgurl:
    displayName: 头像
  desc:
    displayName: 简介
  siteurl:
    displayName: 网站
  linkpage:
    displayName: 友链页
  tags:
    displayName: 标签
  draft:
    displayName: 草稿
  visible:
    displayName: 显示
  order:
    displayName: 排序（小值优先）
  publishAt:
    displayName: 定时发布
  unpublishAt:
    displayName: 定时下线
views:
  - type: table
    name: 表格
    order:
      - file.name
      - id
      - title
      - imgurl
      - desc
      - siteurl
      - linkpage
      - tags
      - draft
      - visible
      - order
      - publishAt
      - unpublishAt
    sort:
      - property: order
        direction: ASC
  - type: cards
    name: 卡片
    order:
      - file.name
      - title
      - name
      - draft
      - visible
      - publishAt
    image: note.cover
    cardSize: 220
