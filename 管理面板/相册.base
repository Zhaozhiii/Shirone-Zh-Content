filters:
  and:
    - file.inFolder("cms/albums")
    - file.ext == "md"
properties:
  key:
    displayName: 相册网址标识
  title:
    displayName: 标题
  description:
    displayName: 简介
  date:
    displayName: 日期
  location:
    displayName: 地点
  tags:
    displayName: 标签
  cover:
    displayName: 封面
  layout:
    displayName: 布局
  columns:
    displayName: 列数（2–4）
  passwordHint:
    displayName: 密码提示
  photos:
    displayName: 照片
  draft:
    displayName: 草稿
  visible:
    displayName: 显示
  order:
    displayName: 排序（小值优先）
  publishAt:
    displayName: 定时发布
  unpublishAt:
    displayName: 定时下线
views:
  - type: table
    name: 表格
    order:
      - file.name
      - key
      - title
      - description
      - date
      - location
      - tags
      - cover
      - layout
      - columns
      - passwordHint
      - photos
      - draft
      - visible
      - order
      - publishAt
      - unpublishAt
    sort:
      - property: order
        direction: ASC
  - type: cards
    name: 卡片
    order:
      - file.name
      - title
      - name
      - draft
      - visible
      - publishAt
    image: note.cover
    cardSize: 220
